# Kavion Super Admin Environment Variables Example

NEXT_PUBLIC_APP_NAME="KavionQuestion Super Admin"

# Supabase Server Key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Admin Separate JWT Secret
ADMIN_JWT_SECRET=your_admin_secret_key_here

# School App Auth & Token Secret
SCHOOL_JWT_SECRET=your_school_jwt_secret_here
SCHOOL_APP_URL=http://localhost:3000

# GoodSender Email API
GOODSENDER_API_KEY=your_goodsender_api_key
GOODSENDER_SENDER_EMAIL=support@yourdomain.com

# Optional SMTP
GMAIL_USER=
GMAIL_APP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
